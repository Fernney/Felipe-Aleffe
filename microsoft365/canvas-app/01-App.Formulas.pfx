// ============================================================================
// Central de Diligenciamento · App.Formulas (substitua TODO o conteúdo)
// Power Apps Studio › Árvore › App › propriedade "Formulas"
//
// Regra de cores:
//   JOPE  (geral, menu, cabeçalho, telas sem filtro) ... 6F3B8C · 3266AF · 12A9A2 · 737373
//   INOVA (somente com filtro INOVA BH) ................. 0D5A55 · 95C11F · 706F6F
//   SAÚDE (somente com filtro SAÚDE BH) ................. 6E368C · 4C2C84 · 4D4D4D
//
// Os tokens corPrimaria, corAzul, corVerdeAgua, corCinza... que o app inteiro
// já usa passam a seguir a unidade ativa. O menu e o cabeçalho usam corJope*,
// que nunca mudam.
// ============================================================================

// ---- unidade ativa: terreno aberto (detalhe) > filtro de concessionária > JOPE
unidadeAtiva = If(!IsBlank(varUnidadeTela), varUnidadeTela, Coalesce(varUnidade, "JOPE"));

// ---- JOPE fixo (menu, cabeçalho, identidade) ----
corJopeRoxo = If(varModoEscuro, RGBA(201, 163, 227, 1), RGBA(111, 59, 140, 1));
corJopeRoxoPreench = If(varModoEscuro, RGBA(122, 71, 160, 1), RGBA(111, 59, 140, 1));
corJopeAzul = If(varModoEscuro, RGBA(110, 155, 225, 1), RGBA(50, 102, 175, 1));
corJopeAgua = If(varModoEscuro, RGBA(40, 190, 182, 1), RGBA(18, 169, 162, 1));
corJopeCinza = RGBA(115, 115, 115, 1);
corJopeMenuAtivo = If(varModoEscuro, RGBA(62, 45, 76, 1), RGBA(241, 232, 246, 1));
corJopeHoverVeu = If(varModoEscuro, RGBA(201, 163, 227, 0.10), RGBA(111, 59, 140, 0.06));
corJopePressVeu = If(varModoEscuro, RGBA(201, 163, 227, 0.18), RGBA(111, 59, 140, 0.12));

// ---- tokens que seguem a unidade ativa ----
corPrimaria = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(120, 205, 197, 1), RGBA(13, 90, 85, 1)),
    "SAUDE", If(varModoEscuro, RGBA(200, 160, 225, 1), RGBA(110, 54, 140, 1)),
    If(varModoEscuro, RGBA(201, 163, 227, 1), RGBA(111, 59, 140, 1)));
corPrimariaEscura = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(60, 140, 132, 1), RGBA(8, 64, 60, 1)),
    "SAUDE", If(varModoEscuro, RGBA(150, 120, 210, 1), RGBA(76, 44, 132, 1)),
    If(varModoEscuro, RGBA(140, 95, 170, 1), RGBA(90, 46, 114, 1)));
// secundária: JOPE azul · INOVA verde-claro · SAÚDE lilás
corAzul = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(175, 215, 80, 1), RGBA(149, 193, 31, 1)),
    "SAUDE", If(varModoEscuro, RGBA(150, 120, 210, 1), RGBA(76, 44, 132, 1)),
    If(varModoEscuro, RGBA(110, 155, 225, 1), RGBA(50, 102, 175, 1)));
// terciária: JOPE verde-água · INOVA verde-claro · SAÚDE lilás
corVerdeAgua = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(175, 215, 80, 1), RGBA(149, 193, 31, 1)),
    "SAUDE", If(varModoEscuro, RGBA(150, 120, 210, 1), RGBA(76, 44, 132, 1)),
    If(varModoEscuro, RGBA(40, 190, 182, 1), RGBA(18, 169, 162, 1)));
corCinza = Switch(unidadeAtiva, "INOVA", RGBA(112, 111, 111, 1), "SAUDE", RGBA(77, 77, 77, 1), RGBA(115, 115, 115, 1));
corPrimariaPreench = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(20, 110, 104, 1), RGBA(13, 90, 85, 1)),
    "SAUDE", If(varModoEscuro, RGBA(122, 71, 160, 1), RGBA(110, 54, 140, 1)),
    If(varModoEscuro, RGBA(122, 71, 160, 1), RGBA(111, 59, 140, 1)));
corMenuAtivo = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(22, 55, 53, 1), RGBA(227, 239, 238, 1)),
    "SAUDE", If(varModoEscuro, RGBA(55, 38, 66, 1), RGBA(239, 230, 244, 1)),
    If(varModoEscuro, RGBA(62, 45, 76, 1), RGBA(241, 232, 246, 1)));
corLinhaSelecionada = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(22, 55, 53, 1), RGBA(240, 247, 246, 1)),
    "SAUDE", If(varModoEscuro, RGBA(50, 40, 60, 1), RGBA(247, 241, 250, 1)),
    If(varModoEscuro, RGBA(50, 40, 60, 1), RGBA(247, 241, 250, 1)));
corHoverVeu = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(120, 205, 197, 0.10), RGBA(13, 90, 85, 0.06)),
    "SAUDE", If(varModoEscuro, RGBA(200, 160, 225, 0.10), RGBA(110, 54, 140, 0.06)),
    If(varModoEscuro, RGBA(201, 163, 227, 0.10), RGBA(111, 59, 140, 0.06)));
corPressVeu = Switch(unidadeAtiva,
    "INOVA", If(varModoEscuro, RGBA(120, 205, 197, 0.18), RGBA(13, 90, 85, 0.12)),
    "SAUDE", If(varModoEscuro, RGBA(200, 160, 225, 0.18), RGBA(110, 54, 140, 0.12)),
    If(varModoEscuro, RGBA(201, 163, 227, 0.18), RGBA(111, 59, 140, 0.12)));
// paleta para gráficos (3 cores da unidade, em ordem)
tblPaletaGrafico = Switch(unidadeAtiva,
    "INOVA", [RGBA(13, 90, 85, 1), RGBA(149, 193, 31, 1), RGBA(112, 111, 111, 1)],
    "SAUDE", [RGBA(110, 54, 140, 1), RGBA(76, 44, 132, 1), RGBA(77, 77, 77, 1)],
    [RGBA(111, 59, 140, 1), RGBA(50, 102, 175, 1), RGBA(18, 169, 162, 1), RGBA(115, 115, 115, 1)]);

// ---- identidade das unidades (etiquetas, sempre iguais) ----
corInova = If(varModoEscuro, RGBA(120, 205, 197, 1), RGBA(13, 90, 85, 1));
corInovaFundo = If(varModoEscuro, RGBA(22, 55, 53, 1), RGBA(227, 239, 238, 1));
corSaude = If(varModoEscuro, RGBA(200, 160, 225, 1), RGBA(110, 54, 140, 1));
corSaudeFundo = If(varModoEscuro, RGBA(55, 38, 66, 1), RGBA(239, 230, 244, 1));

// ---- neutros (sem alteração) ----
corFundo = If(varModoEscuro, RGBA(20, 18, 23, 1), RGBA(244, 243, 247, 1));
corCartao = If(varModoEscuro, RGBA(31, 28, 36, 1), RGBA(255, 255, 255, 1));
corBorda = If(varModoEscuro, RGBA(58, 54, 67, 1), RGBA(228, 225, 234, 1));
corBordaCampo = If(varModoEscuro, RGBA(72, 67, 82, 1), RGBA(217, 212, 225, 1));
corTexto = If(varModoEscuro, RGBA(236, 234, 241, 1), RGBA(43, 37, 48, 1));
corTextoSecundario = If(varModoEscuro, RGBA(179, 173, 188, 1), RGBA(95, 88, 104, 1));
corPerigo = If(varModoEscuro, RGBA(240, 110, 100, 1), RGBA(179, 38, 30, 1));
corPerigoBorda = If(varModoEscuro, RGBA(110, 50, 46, 1), RGBA(240, 201, 198, 1));
corFundoSuave = If(varModoEscuro, RGBA(30, 27, 36, 1), RGBA(250, 249, 252, 1));
corNeutroFundo = If(varModoEscuro, RGBA(44, 41, 50, 1), RGBA(242, 242, 242, 1));
corSucessoFundo = If(varModoEscuro, RGBA(22, 60, 58, 1), RGBA(231, 245, 244, 1));
corSucessoBorda = If(varModoEscuro, RGBA(34, 95, 90, 1), RGBA(170, 222, 218, 1));
corSucesso = If(varModoEscuro, RGBA(120, 215, 205, 1), RGBA(11, 107, 102, 1));
corAvisoFundo = If(varModoEscuro, RGBA(70, 52, 20, 1), RGBA(253, 241, 222, 1));
corAviso = If(varModoEscuro, RGBA(240, 195, 110, 1), RGBA(138, 83, 0, 1));
corPerigoFundo = If(varModoEscuro, RGBA(75, 30, 28, 1), RGBA(252, 236, 235, 1));
corInfoFundo = If(varModoEscuro, RGBA(28, 45, 75, 1), RGBA(231, 238, 248, 1));
corInfo = If(varModoEscuro, RGBA(140, 180, 240, 1), RGBA(35, 76, 133, 1));
corSobrePrimaria = RGBA(255, 255, 255, 1);
corSobrePrimariaSuave = RGBA(255, 255, 255, 0.85);

// ---- status (iguais ao app original) ----
tblStatus = Table(
    {Status: "Concluído", Fundo: If(varModoEscuro, RGBA(22, 60, 58, 1), RGBA(225, 244, 242, 1)), Texto: If(varModoEscuro, RGBA(120, 215, 205, 1), RGBA(11, 107, 102, 1))},
    {Status: "Em andamento", Fundo: If(varModoEscuro, RGBA(28, 45, 75, 1), RGBA(231, 238, 248, 1)), Texto: If(varModoEscuro, RGBA(140, 180, 240, 1), RGBA(35, 76, 133, 1))},
    {Status: "Aguardando", Fundo: If(varModoEscuro, RGBA(70, 52, 20, 1), RGBA(253, 241, 222, 1)), Texto: If(varModoEscuro, RGBA(240, 195, 110, 1), RGBA(138, 83, 0, 1))},
    {Status: "Bloqueado", Fundo: If(varModoEscuro, RGBA(75, 30, 28, 1), RGBA(252, 236, 235, 1)), Texto: If(varModoEscuro, RGBA(245, 140, 130, 1), RGBA(179, 38, 30, 1))},
    {Status: "Não iniciado", Fundo: If(varModoEscuro, RGBA(50, 48, 55, 1), RGBA(240, 240, 240, 1)), Texto: If(varModoEscuro, RGBA(175, 170, 182, 1), RGBA(100, 100, 100, 1))},
    {Status: "Não se aplica", Fundo: If(varModoEscuro, RGBA(34, 31, 40, 1), RGBA(255, 255, 255, 1)), Texto: If(varModoEscuro, RGBA(130, 125, 138, 1), RGBA(150, 150, 150, 1))}
);
// Nível de risco → cores (usado nas telas novas)
tblRisco = Table(
    {Nivel: "Alto", Fundo: If(varModoEscuro, RGBA(75, 30, 28, 1), RGBA(252, 236, 235, 1)), Texto: If(varModoEscuro, RGBA(245, 140, 130, 1), RGBA(179, 38, 30, 1))},
    {Nivel: "Médio", Fundo: If(varModoEscuro, RGBA(70, 52, 20, 1), RGBA(253, 241, 222, 1)), Texto: If(varModoEscuro, RGBA(240, 195, 110, 1), RGBA(138, 83, 0, 1))},
    {Nivel: "Baixo", Fundo: If(varModoEscuro, RGBA(22, 60, 58, 1), RGBA(225, 244, 242, 1)), Texto: If(varModoEscuro, RGBA(120, 215, 205, 1), RGBA(11, 107, 102, 1))}
);

// ---- tipografia e raios (sem alteração) ----
fontePadrao = Font.'Open Sans';
raioCartao = 14;
raioBotao = 10
