// ============================================================================
// COLE ESTE BLOCO em scrHome › btnDashCarregar › OnSelect
// logo ANTES da linha:   // 4) Últimas movimentações (usado no painel de notificações)
// (ou seja, depois de todos os Collect(colAlertas, ...) que já existem)
//
// Cria: colProc (todos os processos num formato só), novos alertas,
//       colDuracao/colPrevisao (previsão de conclusão), colRisco (índice 0–100)
//       e colAgenda (prazos para a tela Agenda).
// ============================================================================

// 3d) Todos os processos num formato único ------------------------------------
ClearCollect(colProc,
    ForAll(colDxParc, {Mod: "Parcelamento", TNome: TNome, Chave: Chave, Sit: Sit,
        Ini: 'Data de Início', Lim: 'Data Limite para Protocolo', Ret: 'Previsão de Retorno',
        Fim: If(false, Today()), Atu: 'Última Atualização'})
);
Collect(colProc, ForAll(colDxDipc, {Mod: "DIPC", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: Lim, Ret: 'Previsão de Retorno', Fim: 'Data de Término', Atu: 'Data de Atualização'}));
Collect(colProc, ForAll(colDxCind, {Mod: "CINDACTA", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: 'Data Limite de Protocolo', Ret: 'Previsão de Retorno', Fim: If(false, Today()), Atu: 'Data de Atualização'}));
Collect(colProc, ForAll(colDxGelin, {Mod: "GELIN", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: 'Data Limite de Protocolo', Ret: 'Previsão de Retorno', Fim: 'Data de Término', Atu: 'Data de Atualização'}));
Collect(colProc, ForAll(colDxGeava, {Mod: "GEAVA", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: 'Data Limite de Protocolo', Ret: 'Previsão de Retorno', Fim: 'Data de Término', Atu: 'Data de Atualização'}));
Collect(colProc, ForAll(colDxAmtt, {Mod: "AMTT", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: 'Data Limite de Protocolo', Ret: 'Previsão de Retorno', Fim: 'Data de Término', Atu: 'Data de Atualização'}));
Collect(colProc, ForAll(colDxAlv, {Mod: "Alvará", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: 'Data Limite de Protocolo', Ret: 'Previsão de Retorno', Fim: 'Data de Emissão', Atu: 'Data de Atualização'}));
Collect(colProc, ForAll(colDxOutros, {Mod: "Outros", TNome: TNome, Chave: Chave, Sit: Sit,
    Ini: 'Data de Início', Lim: 'Data Limite de Protocolo', Ret: 'Previsão de Retorno', Fim: 'Data de Término', Atu: 'Data de Atualização'}));

// 3e) Novos alertas -------------------------------------------------------------
Set(varDiasParado, 60); // processo sem atualização há mais de N dias

// Data limite de protocolo em TODOS os módulos (antes só existia para DIPC)
Collect(colAlertas,
    ForAll(Filter(colProc, Mod <> "DIPC" && !IsBlank(Lim) && Lim <= DateAdd(Today(), 30, TimeUnit.Days) && !(Sit in varSitEncerrada) && Sit <> "Em análise"),
        {Tipo: "Data limite de protocolo", Terreno: TNome, Modulo: Mod, Data: Lim, Alta: Lim < Today(),
         Detalhe: If(Lim < Today(), "Data limite vencida em ", "Data limite em ") & Text(Lim, "dd/mm/yyyy") & " · " & Chave})
);

// Processo parado: aberto e sem atualização há mais de varDiasParado dias
Collect(colAlertas,
    ForAll(Filter(colProc, !(Sit in varSitEncerrada) && !IsBlank(Sit) && !(Sit in ["Não Iniciada", "A iniciar", "Não iniciado"]) && !IsBlank(Coalesce(Atu, Ini)) && DateDiff(Coalesce(Atu, Ini), Today(), TimeUnit.Days) > varDiasParado),
        {Tipo: "Processo parado", Terreno: TNome, Modulo: Mod, Data: Coalesce(Atu, Ini), Alta: false,
         Detalhe: Mod & " · sem atualização há " & DateDiff(Coalesce(Atu, Ini), Today(), TimeUnit.Days) & " dias · " & Chave})
);

// Validade das diretrizes da ARMBH (90 dias)
ClearCollect(colDxArmbh,
    AddColumns('Registros ARMBH',
        TNome, LookUp(colDxParc, ID = 'Parcelamento do Solo'.Id).TNome,
        Val, 'Validade das Diretrizes - ARMBH',
        SitA, Text('Status da Condicionante'.Value))
);
Collect(colAlertas,
    ForAll(Filter(colDxArmbh, !IsBlank(Val) && Val <= DateAdd(Today(), 90, TimeUnit.Days) && !(SitA in varSitEncerrada)),
        {Tipo: "Validade das diretrizes ARMBH", Terreno: TNome, Modulo: "ARMBH", Data: Val, Alta: Val < Today(),
         Detalhe: If(Val < Today(), "Vencida em ", "Vence em ") & Text(Val, "dd/mm/yyyy") & " · SEI " & 'Processo SEI'})
);

// Terreno sem fluxograma respondido
Collect(colAlertas,
    ForAll(Filter(colDashTerrenos, !FluxoRespondido),
        {Tipo: "Fluxograma não respondido", Terreno: Nome, Modulo: "Fluxograma", Data: Today(), Alta: false,
         Detalhe: "Responda as 8 perguntas para saber quais processos abrir"})
);

// 3f) Previsão de conclusão -----------------------------------------------------
// Duração média (dias) de cada módulo, a partir dos processos já concluídos
ClearCollect(colDuracao,
    ForAll(Distinct(colProc, Mod) As m,
        {Mod: m.Value,
         Dias: Round(Average(Filter(colProc, Mod = m.Value && !IsBlank(Ini) && !IsBlank(Fim) && Fim >= Ini), DateDiff(Ini, Fim, TimeUnit.Days)), 0)})
);
// Processos abertos: previsão de retorno informada ou início + duração média
ClearCollect(colPrevisao,
    ForAll(Filter(colProc, !(Sit in varSitEncerrada)) As p,
        With({d: LookUp(colDuracao, Mod = p.Mod).Dias},
            {Mod: p.Mod, TNome: p.TNome, Chave: p.Chave, Sit: p.Sit,
             Prev: Coalesce(p.Ret, If(!IsBlank(p.Ini) && !IsBlank(d), DateAdd(p.Ini, d, TimeUnit.Days))),
             PeloHistorico: IsBlank(p.Ret) && !IsBlank(d)})
    )
);

// 3g) Índice de risco por terreno (0–100) ---------------------------------------
ClearCollect(colTerrPrazo, ForAll(Terrenos, {TId: ID, Nome: 'Nome do Terreno', Prazo: 'Prazo de Liberação', Entrega: 'Previsão de Entrega da Obra'}));
ClearCollect(colRisco,
    ForAll(colDashTerrenos As t,
        With(
            {
                altos: CountRows(Filter(colAlertas, Alta && (Terreno = t.Nome || EndsWith(Terreno, "· " & t.Nome)))),
                todos: CountRows(Filter(colAlertas, Terreno = t.Nome || EndsWith(Terreno, "· " & t.Nome))),
                bloq: CountRows(Filter(Table({s: t.Parc}, {s: t.Dipc}, {s: t.Cind}, {s: t.Gelin}, {s: t.Geava}, {s: t.Amtt}, {s: t.Alv}, {s: t.Outros}), s = "Bloqueado")),
                exig: CountRows(Filter(Table({a: t.AplParc, s: t.Parc}, {a: t.AplDipc, s: t.Dipc}, {a: t.AplCind, s: t.Cind}, {a: t.AplGelin, s: t.Gelin}, {a: t.AplGeava, s: t.Geava}, {a: t.AplAmtt, s: t.Amtt}, {a: t.AplComp, s: t.AmbComp}, {a: t.AplRel, s: t.AmbRel}), a = true)),
                conc: CountRows(Filter(Table({a: t.AplParc, s: t.Parc}, {a: t.AplDipc, s: t.Dipc}, {a: t.AplCind, s: t.Cind}, {a: t.AplGelin, s: t.Gelin}, {a: t.AplGeava, s: t.Geava}, {a: t.AplAmtt, s: t.Amtt}, {a: t.AplComp, s: t.AmbComp}, {a: t.AplRel, s: t.AmbRel}), a = true && s = "Concluído")),
                lib: Max(Filter(colPrevisao, TNome = t.Nome), Prev),
                prazo: LookUp(colTerrPrazo, TId = t.TId).Prazo
            },
            With(
                {
                    atraso: !IsBlank(lib) && !IsBlank(prazo) && lib > prazo,
                    pontos: Min(45, altos * 15) + Min(20, (todos - altos) * 5) + bloq * 20 + t.AAbrir * 8 + t.Conflitos * 10 + If(t.FluxoRespondido, 0, 10)
                },
                With({total: Min(100, pontos + If(atraso, 15, 0))},
                    {
                        TId: t.TId, Nome: t.Nome, Conc: t.Conc, Etapa: t.Etapa,
                        Risco: total,
                        Nivel: If(total >= 55, "Alto", total >= 25, "Médio", "Baixo"),
                        Progresso: If(exig = 0, 0, conc / exig),
                        LiberacaoPrevista: lib,
                        PrazoLiberacao: prazo,
                        Atraso: atraso,
                        Motivos: Concat(
                            Filter(
                                Table(
                                    {c: altos > 0, x: altos & " alerta(s) crítico(s)"},
                                    {c: todos - altos > 0, x: (todos - altos) & " alerta(s) de atenção"},
                                    {c: bloq > 0, x: bloq & " módulo(s) bloqueado(s)"},
                                    {c: t.AAbrir > 0, x: t.AAbrir & " processo(s) a abrir"},
                                    {c: t.Conflitos > 0, x: t.Conflitos & " conflito(s) com o fluxograma"},
                                    {c: !t.FluxoRespondido, x: "fluxograma não respondido"},
                                    {c: atraso, x: "previsão " & Text(lib, "dd/mm/yyyy") & " após o prazo " & Text(prazo, "dd/mm/yyyy")}
                                ),
                                c
                            ),
                            x, " · "
                        )
                    }
                )
            )
        )
    )
);

// 3h) Agenda de prazos ----------------------------------------------------------
ClearCollect(colAgenda,
    ForAll(Filter(colProc, !IsBlank(Lim) && !(Sit in varSitEncerrada)),
        {Data: Lim, Tipo: "Protocolo", Terreno: TNome, Titulo: Mod & " · limite de protocolo"})
);
Collect(colAgenda, ForAll(Filter(colProc, !IsBlank(Ret) && !(Sit in varSitEncerrada)),
    {Data: Ret, Tipo: "Retorno", Terreno: TNome, Titulo: Mod & " · previsão de retorno"}));
Collect(colAgenda, ForAll(Filter(colDxParc, !IsBlank(Venc) && !(Sit in varSitEncerrada)),
    {Data: Venc, Tipo: "Diretrizes", Terreno: TNome, Titulo: "Vencimento das diretrizes"}));
Collect(colAgenda, ForAll(Filter(colDxArmbh, !IsBlank(Val) && !(SitA in varSitEncerrada)),
    {Data: Val, Tipo: "Diretrizes", Terreno: TNome, Titulo: "Validade das diretrizes ARMBH"}));
Collect(colAgenda, ForAll(Filter(colDxAmb, !IsBlank(PrazoTermo) && IsBlank(RecDef)),
    {Data: PrazoTermo, Tipo: "Termo ambiental", Terreno: TNome, Titulo: "Prazo do termo de compromisso"}));
Collect(colAgenda, ForAll(Filter(colTerrPrazo, !IsBlank(Prazo)),
    {Data: Prazo, Tipo: "Liberação", Terreno: Nome, Titulo: "Prazo de liberação do terreno"}));
If(IsBlank(varMesAgenda), Set(varMesAgenda, Date(Year(Today()), Month(Today()), 1)));
