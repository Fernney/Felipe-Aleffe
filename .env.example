# ----------------------------------------------------------------------------
# Central de Diligenciamento — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o arquivo com segredos.
# ----------------------------------------------------------------------------

# URL pública do sistema e segredo de sessão (gere com: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Fonte de dados: "demo" (base fictícia em memória) ou "sharepoint"
DATA_PROVIDER=demo

# --- SharePoint via Microsoft Graph (app registration com Sites.Selected ou Sites.ReadWrite.All) ---
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
# host:/caminho do site
SP_SITE=transpes.sharepoint.com:/sites/CentraldeDiligenciamento_R00
SP_CACHE_SECONDS=60

# --- Login com conta Microsoft (Entra ID) ---
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Mantém o acesso de demonstração mesmo com SharePoint (não use em produção)
DEMO_LOGIN=false

# --- E-mails de alerta (enviados pelo Graph com permissão Mail.Send) ---
MAIL_SENDER=diligenciamento@suaempresa.com.br
ALERT_EMAIL_INOVA=projetos@speinova.com.br
ALERT_EMAIL_SAUDE=projetos@spesaude.com.br
# Segredo do agendamento diário: GET /api/cron/alertas  (Authorization: Bearer ...)
CRON_SECRET=

# --- API de dados para o Power BI: /api/bi/<dataset> (Authorization: Bearer ...) ---
# Mínimo de 24 caracteres
BI_API_TOKEN=

# --- Assistente IA (opcional) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
